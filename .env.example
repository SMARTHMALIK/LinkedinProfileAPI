# Extract both values from your browser after logging into LinkedIn.
# Open DevTools → Application → Cookies → https://www.linkedin.com
# See README for step-by-step instructions.

LINKEDIN_LI_AT=your_li_at_cookie_value_here

# JSESSIONID is used as the CSRF token for LinkedIn's API.
# Required on corporate/proxy networks where the warm-up request is blocked.
# Value looks like: ajax:1234567890123456789
LINKEDIN_JSESSIONID=your_jsessionid_value_here

# GraphQL query IDs — extract from your browser while on a LinkedIn profile page:
#   1. Open LinkedIn in Chrome/Edge, go to any profile page (e.g. linkedin.com/in/satyanadella)
#   2. Open DevTools → Network tab → filter by "graphql"
#   3. Find the request with queryId starting with voyagerIdentityDashProfiles
#      (returns minimal version tag — needed to start the session)
#   4. Find the request with queryId starting with voyagerIdentityDashProfileComponents
#      (returns the actual headline, experience, education, skills, etc.)
# Both values change with each LinkedIn deployment — refresh them if API calls break.
LINKEDIN_GRAPHQL_QUERY_ID=voyagerIdentityDashProfiles.b5c27c04968c409fc0ed3546575b9b7a
LINKEDIN_GRAPHQL_COMPONENTS_QUERY_ID=
