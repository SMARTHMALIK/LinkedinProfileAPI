# Extract both values from your browser after logging into LinkedIn.
# Open DevTools → Application → Cookies → https://www.linkedin.com
# See README for step-by-step instructions.

LINKEDIN_LI_AT=your_li_at_cookie_value_here

# JSESSIONID is used as the CSRF token for LinkedIn's API.
# Required on corporate/proxy networks where the warm-up request is blocked.
# Value looks like: ajax:1234567890123456789
LINKEDIN_JSESSIONID=your_jsessionid_value_here
