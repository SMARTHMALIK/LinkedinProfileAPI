# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn credentials — used by the backend to authenticate against LinkedIn's
# internal Voyager API. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# Your LinkedIn account credentials.
# Used to log in via LinkedIn's mobile auth endpoint (/uas/authenticate) and to
# refresh the session automatically when the cookie below expires.
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your_password_here


# ─────────────────────────────────────────────────────────────────────────────
# Session cookie — REQUIRED for cloud deployments (Render, Railway, Fly, ...)
# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn issues a device challenge for logins originating from datacenter IPs,
# so email/password alone will not authenticate once deployed. Generate a session
# from your own machine (a trusted IP) and paste the two printed values here:
#
#     python tools/get_li_at.py
#
# The app prefers these over email/password when both are present.
# Re-run the script if the API starts returning 401/403.
LINKEDIN_LI_AT=your_li_at_cookie_value_here

# Doubles as the CSRF token for every Voyager API call.
# Keep the surrounding quotes exactly as printed, e.g. "ajax:1234567890123456789"
LINKEDIN_JSESSIONID=your_jsessionid_value_here

