# Extract both values from your browser after logging into LinkedIn.
# Open DevTools → Application → Cookies → https://www.linkedin.com
# See README for step-by-step instructions.

LINKEDIN_LI_AT=your_li_at_cookie_value_here

# JSESSIONID is used as the CSRF token for LinkedIn's API.
# Required on corporate/proxy networks where the warm-up request is blocked.
# Value looks like: ajax:1234567890123456789
LINKEDIN_JSESSIONID=your_jsessionid_value_here

# GraphQL query ID for the profile endpoint — extract from your browser:
#   1. Open LinkedIn in Chrome/Edge, go to any profile page
#   2. Open DevTools → Network tab → filter by "graphql"
#   3. Look for a request to /voyager/api/graphql?queryId=voyagerIdentityDashProfiles.XXXX
#   4. Copy the full queryId value (e.g. voyagerIdentityDashProfiles.6a22bcff3dc5...)
# This value changes with each LinkedIn deployment so refresh it if API calls break.
LINKEDIN_GRAPHQL_QUERY_ID=
LINKEDIN_GRAPHQL_COMPONENTS_QUERY_ID=
