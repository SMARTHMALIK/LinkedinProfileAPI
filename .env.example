# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn credentials — used by the backend to authenticate against LinkedIn's
# internal Voyager API. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# Your LinkedIn account credentials.
# Used to log in via LinkedIn's mobile auth endpoint (/uas/authenticate) and to
# refresh the session automatically when the cookie below expires.
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your_password_here


# ─────────────────────────────────────────────────────────────────────────────
# Session cookies — REQUIRED for cloud deployments (Render, Railway, Fly, ...)
# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn issues a device challenge for logins originating from datacenter IPs,
# so email/password alone will not authenticate once deployed.
#
# PREFERRED: the full cookie string from a logged-in browser. LinkedIn expects
# li_at to arrive alongside its supporting cookies (liap, bcookie, bscookie,
# lidc) and rejects sessions that are missing them. A browser session has also
# already cleared device verification, so it lasts far longer than a scripted one.
#
#   1. Log in to linkedin.com in Chrome
#   2. DevTools (F12) -> Application -> Cookies -> https://www.linkedin.com
#   3. Copy li_at, JSESSIONID, liap and bcookie into the line below
#
# Takes priority over LINKEDIN_LI_AT / LINKEDIN_JSESSIONID when set.
LINKEDIN_COOKIES=li_at=AQED...; JSESSIONID="ajax:1234567890123456789"; liap=true; bcookie=v=2&...

# ALTERNATIVE: the two-variable form, as printed by `python tools/get_li_at.py`.
# Works, but is more likely to be invalidated by LinkedIn's risk engine.
LINKEDIN_LI_AT=your_li_at_cookie_value_here

# Doubles as the CSRF token for every Voyager API call.
# Keep the surrounding quotes exactly as printed, e.g. "ajax:1234567890123456789"
LINKEDIN_JSESSIONID=your_jsessionid_value_here

